# Credentials for the LIVE harnesses in scripts/ — the ones that talk to real
# tenants. Copy to .env (gitignored) and fill in.
#
# Nothing here is needed for `npm test`: the unit suites mock every provider.
# These exist because a mock answers whatever it is asked, and every real bug
# this project has hit came from a shape a mock agreed to.
#
# Values are read into the harness process and never printed; the scripts
# report field shapes, not content.

# --- Shared -----------------------------------------------------------------

# Embeddings, for anything that writes to Qdrant. Must be the same model the
# engines embed with, or scores from different corpora stop being comparable.
OPENAI_API_KEY=

# --- Confluence (scripts/verify-confluence.mjs, e2e-confluence.mjs, e2e-broker.mjs)

# An Atlassian OAuth 2.0 (3LO) app with GRANULAR scopes:
#   read:page:confluence, read:space:confluence,
#   read:content-details:confluence, offline_access
# Classic scopes will not work — the v1 content endpoints they reach are gone.
# Callback URL must include http://localhost:9099/callback
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# --- Slack (scripts/e2e-slack.mjs) ------------------------------------------

# From api.slack.com/apps -> your app -> OAuth & Permissions, after adding the
# scopes below and hitting "Reinstall to Workspace".
#
# Bot Token Scopes:  channels:history, channels:read, channels:join
#   channels:join is only needed if the Corpus sets autoJoin; without it,
#   /invite the app into the channel by hand.
SLACK_BOT_TOKEN=

# User Token Scopes: channels:read
#   Not optional. A probe asks whether THIS USER may read a channel, and a bot
#   token answers whether the BOT may — a different question. This token only
#   appears after a User Token Scope exists AND you have reinstalled.
SLACK_USER_TOKEN=

# The channel id (C…), from channel details. An id, not a name: names are
# mutable and a rename must not silently re-point a corpus at other material.
# Pick one with at least one real THREAD — a message with replies.
SLACK_CHANNEL_ID=

# Used for citation permalinks.
SLACK_WORKSPACE_URL=https://example.slack.com

# Basic Information -> App Credentials. Only needed to exercise webhooks.
SLACK_SIGNING_SECRET=

# --- Google Drive (scripts/e2e-gdrive.mjs) ----------------------------------

# A Google Cloud project with the Drive API enabled, then
# Create OAuth client ID -> Web application.
# Authorized redirect URI must be exactly http://localhost:9099/callback
# Scope used: https://www.googleapis.com/auth/drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The folder id — the segment after /folders/ in the folder URL.
#
# Put THREE things in it, because each exercises a different path: a Google
# Doc (exported, it has no bytes to download), a plain-text file (downloaded
# directly), and a subfolder containing a file (walks the parent chain, which
# is the least-validated code in that driver).
GDRIVE_FOLDER_ID=

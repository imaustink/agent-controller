# Configuration for the fake-mcp-server (docs/adr/0045).
#
# E2E-only fixture. It enforces NO auth and needs no credential or secret of its
# own — it only REFLECTS the inbound Bearer token via the whoami tool. These are
# the only knobs it reads.

# The port the HTTP server listens on (healthz + the MCP endpoint).
PORT=8080

# The path of the MCP streamable-http endpoint, served on POST. The broker's
# MCPServer CR points its url at this path.
MCP_PATH=/mcp

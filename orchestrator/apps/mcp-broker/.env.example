# Configuration for the mcp-broker (docs/adr/0045).
#
# Nothing here is needed for `npm test`: the unit suites fake the MCP SDK and
# the k8s API, so no credential and no network are touched. These are the knobs
# the running Deployment reads.

# --- Required ---------------------------------------------------------------

# The shared secret the agent engines present on the invocation API
# (Authorization: Bearer <token>). The broker rejects any other bearer. Named
# ORCHESTRATOR_TOKEN to match connection-broker — both brokers answer to the
# same caller class. The broker exits at startup if this is unset rather than
# accepting nothing and looking like a networking problem.
ORCHESTRATOR_TOKEN=

# --- Kubernetes -------------------------------------------------------------

# The namespace the MCPServer CRs, their Secrets and the derived MCPTool CRs
# all live in (ADR 0045: one namespace, like connection-broker). In-cluster the
# ServiceAccount's own namespace; out of cluster, set explicitly.
NAMESPACE=default

# The CRD coordinates. Defaults match orchestrator/controllers/core-controller.
CRD_GROUP=core.controller-agent.dev
CRD_VERSION=v1alpha1

# --- Tuning -----------------------------------------------------------------

# The port the invocation HTTP API listens on.
PORT=8080

# How often discovery re-lists every server's tools, in milliseconds, in
# addition to on-load and on-change. Default 5 minutes. A server that adds or
# removes a tool between resyncs is still picked up on the next watch event;
# this bound is what catches a change the watch never delivered.
DISCOVERY_INTERVAL_MS=300000

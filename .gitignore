node_modules
dist
.env
.env.local
# Harness OAuth refresh tokens. Same class of secret as .env, same treatment.
.oauth-cache.json
*.log
npm-debug.log*
.DS_Store
coverage

# Private keys and credentials
*.pem
*.key
*.p12
*.pfx
*.kubeconfig

# Editor and IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Go workspace (applies to orchestrator/controllers/ subproject)
go.work
go.work.sum

# Fetched Helm chart dependencies (run `helm dependency build` to refetch);
# Chart.lock IS committed to pin versions, the downloaded .tgz artifacts are not.
# Recursive so the umbrella chart's nested subchart deps are covered too
# (e.g. orchestrator/charts/agent-controller/charts/agent-orchestrator/charts/qdrant-*.tgz).
orchestrator/charts/**/charts/*.tgz

# Generated copy of the CRDs from orchestrator/controllers/core-controller/config/crd/bases/
# (run `make manifests` there, or `make sync-crds` to just refresh the copy,
# before `helm install`/`helm template`/`helm package` against this chart --
# see orchestrator/charts/agent-controller/charts/core-controller/crds/README.md).
orchestrator/charts/agent-controller/charts/core-controller/crds/*.yaml
.claude/settings.local.json

# Python bytecode from the helm-values-form tool test run
__pycache__/
*.pyc

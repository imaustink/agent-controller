# Base URL of the Glyph instance (fixed, trusted config — never taken from
# tool input). The tool appends `/api/v1`. e.g. https://glyph.example.com
GLYPH_BASE_URL=

# Glyph access token requests authenticate with. In production this is
# injected per-invocation as the CALLING user's own OAuth-delegated token via
# ToolRunSpec.secretEnv (Glyph's per-user delegation) when the Tool declares
# identityProviders: [glyph] — never a static value baked in here. For local
# development, mint a token for your own account with page:* / task:* scopes.
GLYPH_TOKEN=

# Optional: per-request timeout in milliseconds (default 30000).
GLYPH_FETCH_TIMEOUT_MS=30000

# Messaging transport (see ../../docs/messaging.md)
RECIPE_TRANSPORT=
RECIPE_JOB_ID=
RECIPE_CALLBACK_URL=
RECIPE_CALLBACK_SECRET=
RECIPE_CALLBACK_ALLOWED_HOSTS=
